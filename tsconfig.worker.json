{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/cloudflare", "src/server/rooms.ts", "src/server/signaling.ts", "src/server/turn.ts", "src/shared", "tests/invite-storage.test.ts"]
}
