# Copy to .env and fill in. Never commit .env.

# Port the Bun app listens on (host and container).
PORT=8080
# Interface the app port binds to on the host. Use 127.0.0.1 when Caddy or Tailscale serve it.
APP_BIND=0.0.0.0

# Shared secret between the app and coturn for time-limited TURN credentials.
# Generate one with: openssl rand -base64 32
TURN_SECRET=change-me-to-a-long-random-string

# Hostname browsers should use to reach TURN. Empty = the hostname the page was loaded from.
TURN_HOST=
TURN_PORT=3478
TURN_REALM=streamroom
# UDP relay port range coturn uses (open these in your firewall for remote friends).
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Address coturn relays from. Empty = this host's first non-Docker IPv4 address.
TURN_RELAY_IP=
# Public IP when the host is behind NAT (home router). Forward TURN_PORT and the relay range to it.
TURN_EXTERNAL_IP=
# How long TURN credentials stay valid, in seconds.
TURN_TTL_SECONDS=43200
# Comma-separated STUN URLs. Empty = use coturn's STUN on TURN_HOST:TURN_PORT.
STUN_URLS=

# For the `public` compose profile (Caddy with automatic HTTPS). scripts/setup.sh fills these in.
DOMAIN=
# Host ports Caddy publishes. Let's Encrypt needs 80 and 443; change them only for local tests.
HTTP_PORT=80
HTTPS_PORT=443

# Required to create rooms on a public server. Empty means open access.
HOST_PASSPHRASE=
